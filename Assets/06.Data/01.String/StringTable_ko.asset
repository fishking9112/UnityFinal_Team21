      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186570
    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC758 \uBAAC\uC2A4\uD130\uC5D0\uAC8C
      Lv 2 \uACF5\uACA9\uB825 + \uACF5\uACA9\uC18D\uB3C4 \uBC84\uD504\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186571
    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC758 \uBAAC\uC2A4\uD130\uC758 \uCCB4\uB825\uC744
