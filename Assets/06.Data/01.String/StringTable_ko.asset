    m_Metadata:
      m_Items: []
  - m_Id: 9421799186558
    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC758 \uD788\uC5B4\uB85C\uC5D0\uAC8C
      Lv 3 \uC2AC\uB85C\uC6B0 \uB514\uBC84\uD504\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186559
    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC758 \uD788\uC5B4\uB85C\uC5D0\uAC8C
      \uB370\uBBF8\uC9C0\uB97C \uC785\uD788\uACE0 Lv 2 \uD654\uC0C1 \uB514\uBC84\uD504\uB97C
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186560
    m_Localized: "\uBAA8\uB4E0 \uBAAC\uC2A4\uD130\uC758 \uCCB4\uB825\uC744 \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186561
    m_Localized: "\uC120\uD0DD\uD55C \uBAAC\uC2A4\uD130\uB97C \uD76C\uC0DD\uD558\uC5EC
      \uC18C\uD658 \uAC8C\uC774\uC9C0\uB97C \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186562
    m_Localized: "\uB9C8\uB098\uB97C \uC18C\uBAA8\uD558\uC5EC \uC18C\uD658 \uAC8C\uC774\uC9C0\uB97C
      \uD68C\uBCF5\uD5A1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186563
    m_Localized: "\uC18C\uD658 \uAC8C\uC774\uC9C0\uB97C \uBAA8\uB450 \uD68C\uBCF5\uD558\uC9C0\uB9CC
      10\uCD08\uAC04 \uC18C\uD658\uAC8C\uC774\uC9C0\uAC00 \uC790\uB3D9 \uD68C\uBCF5
      \uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186564
    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC758 \uBAAC\uC2A4\uD130\uB97C \uC131\uCC44
      \uC8FC\uBCC0\uC73C\uB85C \uC21C\uAC04\uC774\uB3D9 \uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186565
    m_Localized: "10\uCD08\uAC04 \uC131\uCC44\uAC00 \uB370\uBBF8\uC9C0\uB97C \uC785\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186566
    m_Localized: "\uC131\uCC44 \uC8FC\uBCC0\uC5D0 30\uCD08\uAC04 \uC720\uC9C0\uB418\uB294
      \uBAAC\uC2A4\uD130\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186567
    m_Localized: "\uC774\uB3D9\uC744 \uBC29\uD574\uD558\uB294 \uC7A5\uC560\uBB3C\uC744
      \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186568
    m_Localized: "\uC77C\uC815 \uC2DC\uAC04\uC774 \uC9C0\uB098\uAC70\uB098 \uC8FD\uC744
