    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC5D0 \uBC88\uAC1C\uAC00 \uB5A8\uC5B4\uC9C0\uBA70
      \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
