  - m_Id: 9421799186573
    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC758 \uD788\uC5B4\uB85C\uC5D0\uAC8C
      \uB370\uBBF8\uC9C0\uB97C \uC785\uD788\uACE0 Lv 2 \uBD80\uD328 \uB514\uBC84\uD504\uB97C
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9421799186574
    m_Localized: "\uC77C\uC815 \uBC94\uC704\uC758 \uD788\uC5B4\uB85C\uC5D0\uAC8C
      \uB808\uC774\uC800\uAC00 \uB5A8\uC5B4\uC9C0\uBA70 \uB370\uBBF8\uC9C0\uB97C
      \uC785\uD788\uACE0 Lv1 \uC2AC\uB85C\uC6B0 \uB514\uBC84\uD504\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
